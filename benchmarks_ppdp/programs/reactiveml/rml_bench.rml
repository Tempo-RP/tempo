let benchmark = ref "propagation_chains"
let size = ref 10
let run_id = ref 1

let effective_propagation n = max 1 n
let effective_broadcast n = max 1 n
let effective_fork_depth n =
  let n = max 2 n in
  max 1 (int_of_float (log (float_of_int n) /. log 2.))
let effective_guard_depth n = max 1 n
let effective_preemption_depth n = max 1 n
let effective_multi_rounds n =
  let n = max 2 n in
  max 2 (int_of_float (log (float_of_int n) /. log 2.))
let effective_supervision_sensors n = max 1 n
let effective_supervision_rounds n =
  let n = max 2 n in
  max 8 (2 * int_of_float (log (float_of_int n) /. log 2.))

let instants_for bench n =
  match bench with
  | "propagation_chains_multi" -> effective_multi_rounds n
  | "broadcast_expansion" -> 2
  | "fork_explosion" -> effective_fork_depth n
  | "guarded_cascades_multi" -> effective_multi_rounds n
  | "nested_preemption" -> 2
  | "reactive_supervision" -> (2 * effective_supervision_rounds n) + 1
  | _ -> 1

let parse_args () =
  let specs = [
    ("--benchmark", Arg.Set_string benchmark, "Benchmark name");
    ("--size", Arg.Set_int size, "Benchmark size parameter");
    ("--run", Arg.Set_int run_id, "Run index");
  ] in
  Arg.parse specs (fun _ -> ()) "rml_bench --benchmark <name> --size <n> --run <k>"

let process link signals i =
  await immediate signals.(i);
  emit signals.(i + 1)

let process bench_propagation n =
  let n = effective_propagation n in
  let signals = Array.init (n + 1) (fun _ -> signal s in s) in
  for i = 0 to n - 1 dopar
    run (link signals i)
  done
  ||
  await immediate signals.(n)
  ||
  emit signals.(0)

let rec process repeat_propagation rounds n =
  if rounds <= 0 then ()
  else
    (run (bench_propagation n);
     if rounds <= 1 then
       ()
     else
       (pause;
        run (repeat_propagation (rounds - 1) n)))

let process bench_propagation_multi n =
  let rounds = effective_multi_rounds n in
  run (repeat_propagation rounds n)

let process observer trigger =
  await immediate trigger

let rec process observers n trigger =
  if n <= 0 then ()
  else
    (run (observer trigger)
     ||
     run (observers (n - 1) trigger))

let process bench_broadcast n =
  let n = effective_broadcast n in
  signal trigger in
  run (observers n trigger)
  ||
  emit trigger

let rec process fork_tree depth =
  if depth <= 0 then ()
  else (
    pause;
    (run (fork_tree (depth - 1))
     ||
     run (fork_tree (depth - 1))))

let process bench_fork n =
  run (fork_tree (effective_fork_depth n))

let rec process guarded guards i done_sig =
  if i >= Array.length guards then
    emit done_sig
  else
    do
      run (guarded guards (i + 1) done_sig)
    when guards.(i)
    done

let rec process emit_many guards i =
  if i >= Array.length guards then ()
  else (
    emit guards.(i);
    run (emit_many guards (i + 1)))

let process bench_guarded n =
  let depth = effective_guard_depth n in
  let guards = Array.init depth (fun _ -> signal guard in guard) in
  signal done_sig in
  run (guarded guards 0 done_sig)
  ||
  await immediate done_sig
  ||
  run (emit_many guards 0)

let rec process repeat_guarded rounds n =
  if rounds <= 0 then ()
  else
    (run (bench_guarded n);
     if rounds <= 1 then
       ()
     else
       (pause;
        run (repeat_guarded (rounds - 1) n)))

let process bench_guarded_multi n =
  let rounds = effective_multi_rounds n in
  run (repeat_guarded rounds n)

let rec process spin_forever =
  pause;
  run spin_forever

let rec process spinner steps =
  if steps <= 0 then ()
  else
    (pause;
     run (spinner (steps - 1)))

let rec process nested_watch i depth cancel_even cancel_odd =
  if i >= depth then
    run (spinner (depth + 3))
  else
    let cancel = if i mod 2 = 0 then cancel_even else cancel_odd in
    do
      run (nested_watch (i + 1) depth cancel_even cancel_odd)
    until cancel
    done

let process killer cancel_even =
  pause;
  emit cancel_even

let process bench_preemption n =
  let depth = effective_preemption_depth n in
  signal cancel_even, cancel_odd in
  run (nested_watch 0 depth cancel_even cancel_odd)
  ||
  run (killer cancel_even)

let sensor_value id round =
  ((id + 1) * (round + 3) + (id mod 7)) mod 97

let score_readings readings =
  List.fold_left
    (fun acc (id, round, value) -> acc + ((id + 1) * value) + round)
    0 readings

let process sensor id rounds tick ready readings observed =
  for round = 0 to rounds - 1 do
    await immediate tick;
    do
      emit readings (id, round, sensor_value id round);
      incr observed
    when ready
    done;
    pause
  done

let rec process sensors_loop id count rounds tick ready readings observed =
  if id >= count then ()
  else
    (run (sensor id rounds tick ready readings observed)
     ||
     run (sensors_loop (id + 1) count rounds tick ready readings observed))

let rec process supervisor round rounds tick ready readings alert total =
  if round >= rounds then ()
  else (
    emit ready;
    emit tick;
    await readings(batch) in
    let score = score_readings batch in
    total := !total + score;
    emit alert score;
    pause;
    run (supervisor (round + 1) rounds tick ready readings alert total))

let process actuator_step alert total count =
  await alert(score) in
  total := !total + score;
  incr count

let rec process actuator remaining alert total count =
  if remaining <= 0 then ()
  else
    (run (actuator_step alert total count);
     run (actuator (remaining - 1) alert total count))

let rec process resetter round rounds reset =
  if round >= rounds then ()
  else (
    pause;
    if round > 0 && round mod 5 = 0 then emit reset;
    run (resetter (round + 1) rounds reset))

let rec process maintenance round rounds reset =
  if round >= rounds then ()
  else
    (do
       pause;
       pause
     until reset
     done;
     run (maintenance (round + 1) rounds reset))

let process bench_supervision n =
  let sensor_count = effective_supervision_sensors n in
  let rounds = effective_supervision_rounds n in
  let observed = ref 0 in
  let supervisor_total = ref 0 in
  let actuator_total = ref 0 in
  let alert_count = ref 0 in
  signal tick, ready, reset in
  signal alert default 0 gather fun score _ -> score in
  signal readings default [] gather fun reading acc -> reading :: acc in
  run (supervisor 0 rounds tick ready readings alert supervisor_total)
  ||
  run (actuator rounds alert actuator_total alert_count)
  ||
  run (resetter 0 rounds reset)
  ||
  run (maintenance 0 rounds reset)
  ||
  run (sensors_loop 0 sensor_count rounds tick ready readings observed);
  let expected_sensor_events = sensor_count * rounds in
  if !observed <> expected_sensor_events then
    failwith
      ("supervision sensor mismatch: expected "
       ^ string_of_int expected_sensor_events
       ^ " got "
       ^ string_of_int !observed);
  if !alert_count < max 1 (rounds - 1) then
    failwith
      ("supervision alert mismatch: expected at least "
       ^ string_of_int (max 1 (rounds - 1))
       ^ " got "
       ^ string_of_int !alert_count);
  if !actuator_total <= 0 then
    failwith
      ("supervision actuator total mismatch: "
       ^ string_of_int !actuator_total);
  if !supervisor_total <= 0 then
    failwith
      ("supervision supervisor total mismatch: "
       ^ string_of_int !supervisor_total)

let process selected =
  match !benchmark with
  | "propagation_chains" -> run (bench_propagation !size)
  | "propagation_chains_multi" -> run (bench_propagation_multi !size)
  | "broadcast_expansion" -> run (bench_broadcast !size)
  | "fork_explosion" -> run (bench_fork !size)
  | "guarded_cascades" -> run (bench_guarded !size)
  | "guarded_cascades_multi" -> run (bench_guarded_multi !size)
  | "nested_preemption" -> run (bench_preemption !size)
  | "reactive_supervision" -> run (bench_supervision !size)
  | x -> invalid_arg ("unknown benchmark: " ^ x)

let peak_mb () =
  let st = Gc.stat () in
  (float_of_int st.Gc.heap_words *. float_of_int Sys.word_size /. 8.0)
  /. (1024.0 *. 1024.0)

let () =
  parse_args ();
  Gc.full_major ();
  let t0 = Unix.gettimeofday () in
  run selected;
  let t1 = Unix.gettimeofday () in
  Gc.full_major ();
  let time_ms = (t1 -. t0) *. 1000.0 in
  let instants = instants_for !benchmark !size in
  let line =
    "rml,"
    ^ !benchmark
    ^ ","
    ^ string_of_int !size
    ^ ","
    ^ string_of_int !run_id
    ^ ","
    ^ string_of_float time_ms
    ^ ","
    ^ string_of_int instants
    ^ ","
    ^ string_of_float (peak_mb ())
  in
  print_endline line;
  flush stdout
