(rule
 (alias runtest)
 (package tempo-ppx)
 (deps check_compile_failure.sh invalid_payload.ml)
 (action
  (run sh %{dep:check_compile_failure.sh} %{ocamlc}
   %{exe:../../ppx/tempo_ppx_test_driver.exe} %{dep:invalid_payload.ml}
   "tempo.parallel expects a literal OCaml list of branch expressions")))

